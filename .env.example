# Copie este arquivo para ".env" na raiz do projeto e ajuste os valores.
PORT=3001
# Quantos proxies confiáveis existem à frente da API (0 = acesso direto). Use 1 atrás de Nginx/Render etc.
TRUST_PROXY=0
CLIENT_ORIGIN=http://localhost:5173
# Gere um segredo longo e aleatório. Obrigatório em produção.
JWT_SECRET=replace-with-a-long-random-secret
