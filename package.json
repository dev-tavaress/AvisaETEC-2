{
  "name": "avisaetec",
  "private": true,
  "version": "1.0.0",
  "description": "AvisaETEC - sistema de avisos e notificações em tempo real para a ETEC",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,green \"npm run dev -w client\" \"npm run dev -w server\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "format": "prettier --write \"client/src/**/*.{js,jsx}\" \"server/src/**/*.js\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}
